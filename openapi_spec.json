{
  "openapi": "3.1.0",
  "info": {
    "title": "Multi-Agent Blackboard Bus API",
    "version": "2.0.1",
    "description": "Deterministic three-worker evaluation. This API is unauthenticated and audit records are in-memory only."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "Service metadata"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory JSON counters",
        "responses": {
          "200": {
            "description": "Counters"
          }
        }
      }
    },
    "/metrics/prometheus": {
      "get": {
        "summary": "Prometheus text-format counters",
        "responses": {
          "200": {
            "description": "Prometheus metric samples",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate task using three deterministic workers",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SystemTaskPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier and audit entry hash"
          },
          "422": {
            "description": "Validation error or prohibited identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return mock supervisor response (no model inference)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "422": {
            "description": "Prohibited identifier"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read and verify in-memory audit entries",
        "responses": {
          "200": {
            "description": "Audit chain status and entries"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemTaskPayload": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "target_identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "primary_metric": {
            "type": "number"
          },
          "secondary_metric": {
            "type": "number",
            "default": 0
          },
          "status_descriptor": {
            "type": "string",
            "default": "NOMINAL",
            "maxLength": 256
          },
          "is_critical_flag": {
            "type": "boolean",
            "default": false
          },
          "attributes": {
            "type": "object"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "target_identifier",
          "primary_metric"
        ]
      }
    }
  }
}
